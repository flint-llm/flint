FROM dataspine/train:cpu-{{ DATASPINE_IMAGE_TAG }}

ARG model_type
RUN \
  echo $model_type
ENV \
  DATASPINE_MODEL_TYPE=$model_type

ARG model_name
RUN \
  echo $model_name
ENV \
  DATASPINE_MODEL_NAME=$model_name

ARG model_tag
RUN \
  echo $model_tag
ENV \
  DATASPINE_MODEL_TAG=$model_tag

ARG model_path
RUN \
  echo $model_path
ENV \
  DATASPINE_MODEL_PATH=/root/model/$model_type/$model_name/$model_tag

COPY $model_path $DATASPINE_MODEL_PATH
RUN \
   sudo chmod a+rwx -R $DATASPINE_MODEL_PATH
RUN \
   echo "DATASPINE_MODEL_PATH=$DATASPINE_MODEL_PATH"

ENV \
  DATASPINE_MODEL_TRAIN_CONDA_ENV_NAME=dataspine-train-$model_type-$model_name-$model_tag

RUN \
  if [ -f "$DATASPINE_MODEL_PATH/dataspine_conda_environment.yml" ]; then \
    echo "" \
    && echo "Creating Conda Environment '$DATASPINE_MODEL_TRAIN_CONDA_ENV_NAME' with '$DATASPINE_MODEL_PATH/dataspine_conda_environment.yml'..." \
    && echo "" \
    && conda env update --name $DATASPINE_MODEL_TRAIN_CONDA_ENV_NAME --file $DATASPINE_MODEL_PATH/dataspine_conda_environment.yml \ 
    && echo "" \
    && echo "...Conda Environment Updated!" \
    && echo ""; \
  fi

RUN \
  echo "source activate $DATASPINE_MODEL_TRAIN_CONDA_ENV_NAME" >> ~/.bashrc

RUN \
  source activate $DATASPINE_MODEL_TRAIN_CONDA_ENV_NAME && conda env list && conda list

RUN \
    if [ -f "$DATASPINE_MODEL_PATH/Guild" ]; then \
         echo "" \
         && echo "Starting Guild-based TensorFlow Training with learning_rate=[0.05, 0.025]..." \
         && echo "" \
         && cd $DATASPINE_MODEL_PATH \
         && guild prepare \
         && guild train --flag=learning_rate=0.05 \
         && guild evaluate --latest-run \
         && guild train --flag=learning_rate=0.025 \
         && guild evaluate --latest-run \
         && echo "" \
         && echo "...Training Complete!" \
         && echo ""; \
   fi

RUN \
   if [ -f "$DATASPINE_MODEL_PATH/dataspine_install.sh" ]; then \
     CONDA_ENV_ROOT_PATH=$(conda info --root) \
     && echo "Installing '$DATASPINE_MODEL_PATH/dataspine_install.sh' into Conda Environment '$DATASPINE_MODEL_TRAIN_CONDA_ENV_NAME'..." \
     && conda info --root \
     && conda env list \
     && echo "" \
     && source activate $DATASPINE_MODEL_TRAIN_CONDA_ENV_NAME \
     && echo "Running '$DATASPINE_MODEL_PATH/dataspine_install.sh'..." \
     && sudo chmod a+x $DATASPINE_MODEL_PATH/dataspine_install.sh \
     && $DATASPINE_MODEL_PATH/dataspine_install.sh \
     && export \
     && echo "" \
     && echo "...Successfully Installed!" \
     && echo ""; \
   fi
