apiVersion: config.istio.io/v1alpha2 
kind: RouteRule 
metadata:
  name: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}-invocations
spec:
   destination: 
      name: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}
   match:
     request:
       headers:
         uri:
           prefix: /{{ DATASPINE_MODEL_NAME }}/invocations 
   rewrite:
     uri: /invocations
   precedence: 2
   route:
   # Note:  'tag' is used by PipelineAI, 'version' is used by Istio.
   #        for now, keep these together - and keep them the same value
   {% for idx in range(DATASPINE_MODEL_NUM_TAGS_AND_WEIGHTS) %}
   - labels:
       tag: "{{ DATASPINE_MODEL_TAG_LIST[idx] }}"
       version: "{{ DATASPINE_MODEL_TAG_LIST[idx] }}"
     weight: {{ DATASPINE_MODEL_WEIGHT_LIST[idx] }}
   {% endfor %}
---
apiVersion: config.istio.io/v1alpha2
kind: RouteRule
metadata:
  name: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}-ping
spec:
  destination:
    name: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}
  match:
    request:
      headers:
        uri:
          prefix: /{{ DATASPINE_MODEL_NAME }}/ping
  rewrite:
    uri: /ping
  precedence: 2 
  route:
  - weight: 100
---
