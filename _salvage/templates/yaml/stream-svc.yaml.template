apiVersion: v1
kind: Service
metadata:
  name: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}-{{ DATASPINE_MODEL_TAG }}
  labels:
    app: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}-{{ DATASPINE_MODEL_TAG }}
spec:
  ports:
    # the port that this service should serve on
  - name: http-kafka
    port: 9092
    targetPort: 9092
  - name: http-schemaregistry
    port: 8081
    targetPort: 8081
  - name: http-restproxy
    port: 8082
    targetPort: 8082
  - name: mqqt
    port: 1883
    targetPort: 1883
#  - name: http-zookeeper
#    port: 2181
#    targetPort: 2181
  selector:
    app: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}-{{ DATASPINE_MODEL_TAG }}
