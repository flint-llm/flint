apiVersion: networking.istio.io/v1alpha3
kind: VirtualService 
metadata:
   name: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}-metrics 
spec:
   hosts: 
      - "*" 
   gateways: 
      - test-gateway 
   http:
   - match:
     - uri:
          prefix: /predict/{{ DATASPINE_MODEL_NAME }}/metrics/
     rewrite:
        uri: /metrics/
     route:
     - destination: 
          host: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}.default.svc.cluster.local
          port:
            number: 9090 
       weight: 100


