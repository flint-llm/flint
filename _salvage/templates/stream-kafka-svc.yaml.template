apiVersion: v1
kind: Service
metadata:
  name: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}
  labels:
    app: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}
    broker: kafka
spec:
  type: LoadBalancer
  ports:
    # the port that this service should serve on
  - name: http-kafka
    port: 9092
    targetPort: 9092
  - name: http-schemaregistry
    port: 8081
    targetPort: 8081
  - name: http-restproxy
    port: 80
    targetPort: 8082
#  - name: http-zookeeper
#    port: 2181
#    targetPort: 2181
  selector:
    app: {{ DATASPINE_IMAGE_REGISTRY_NAMESPACE }}-{{ DATASPINE_MODEL_NAME }}
    broker: kafka
